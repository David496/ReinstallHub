{
  "name": "reinstall-hub",
  "version": "1.0.0",
  "description": "Windows Post-Format Software Reinstallation Suite powered by WinGet",
  "main": "dist/main/main.js",
  "author": "ReInstall Hub Team",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -r -s first \"npm run dev:vite\" \"wait-on tcp:5173 && npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "node scripts/build-electron.js --watch",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "start": "electron dist/main/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "wait-on": "^8.0.2"
  }
}
